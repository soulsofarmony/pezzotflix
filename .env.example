# Copy to .env (never committed) and adjust. Used by deploy/compose.yaml.
HTTP_PORT=8080
# Host folder with the media library (mounted read-only at /media). Windows: E:/Media. It must exist: a wrong
# path stops `docker compose up` instead of mounting an empty folder.
MEDIA_DIR=../media-samples/library
# Library roots inside the container: JSON array of {name, path, hint: movies|series|mixed}. These are the folders
# of the sample library; for the real library, following docs/library-standard.md:
# LIBRARY_ROOTS=[{"name":"Film","path":"/media/Film","hint":"movies"},{"name":"Serie","path":"/media/Serie","hint":"series"},{"name":"Documentari","path":"/media/Documentari","hint":"movies"}]
LIBRARY_ROOTS=[{"name":"Film","path":"/media/movies","hint":"movies"},{"name":"Serie","path":"/media/series","hint":"series"}]
LIBRARY_SCAN_INTERVAL_MIN=15
# Days a missing file waits before it is forgotten by itself (its titles leave the catalog; it comes back with them
# if it reappears). Never on a library the unmounted-root guard sees as unmounted; a separate disk mounted in a
# subfolder of a library is not covered. 0 turns it off; forgetting stays in the admin.
MISSING_REMOVE_AFTER_DAYS=30
LOG_LEVEL=info
# Optional: TMDB API Read Access Token (v4). Without it the library works on Wikidata only.
TMDB_READ_TOKEN=
# Linux or NAS hosts: a group id that can read MEDIA_DIR. The Video Service runs as uid/gid 1000 (its volumes are
# created for that user) and joins this group for the media only.
MEDIA_GID=1000
# Host names the gateway answers to, besides IP addresses and localhost (space-separated, any port), e.g. a
# .local name. Any other Host gets 421: a page on the LAN cannot reach the app through a name of its own.
PZF_HOSTS=
