{
  "name": "@pezzotflix/video",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "contract:bundle": "redocly bundle contract/openapi.yaml -o contract/dist/openapi.json",
    "contract:lint": "redocly lint contract/openapi.yaml",
    "contract:types": "npm run contract:bundle && openapi-typescript contract/dist/openapi.json -o src/contract/schema.d.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test && depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "contract:check": "npm run contract:lint && npm run contract:types && git diff --exit-code -- contract/dist src/contract",
    "verify": "npm run contract:check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@fastify/send": "4.2.1",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "execa": "10.2.1",
    "fastify": "5.12.8",
    "fastify-openapi-glue": "4.12.0",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "2.75.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "openapi-typescript": "7.13.0",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
