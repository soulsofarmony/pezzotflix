{
  "name": "@pezzotflix/web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "contract:types": "openapi-typescript ../../services/video/contract/dist/openapi.json -o src/api/schema.d.ts",
    "contract:check": "npm run contract:types && git diff --exit-code -- src/api/schema.d.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "npm run contract:check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "hls.js": "1.7.4",
    "libpgs": "0.9.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
