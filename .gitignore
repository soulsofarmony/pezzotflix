# Media (never commit media files)
media-samples/*
!media-samples/README.md
*.mkv
*.mp4
*.m2ts
*.iso
# MPEG-TS media: only outside source trees (TypeScript uses .ts too)
media-samples/**/*.ts
spikes/**/*.ts

# Runtime / application data
data/
cache/
*.db
*.sqlite
*.sqlite3

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
# The bundled API contract is committed: clients generate their types from it (ADR 0004)
!services/video/contract/dist/
build/
.vite/
coverage/

# Android / JVM
.gradle/
*.apk
local.properties

# Spike outputs
spikes/**/out/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
